# Names only - never commit real values. Copy to .env.local / .env.docker.
DB_CONNECTION_STRING=

# Optional table name overrides (defaults match data_dashboard)
DB_TABLE=
DB_COMPANIES_TABLE=
DB_TECH_TABLE=
DB_BENCHMARKS_TABLE=
DB_EMPLOYEES_TABLE=
DB_EMAILS_TABLE=
DB_LEADS_TABLE=

SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
EXTERNAL_API_KEY=

# Twenty CRM (optional). Contacts are matched on the `vdmamemberid` field of
# the CRM's `people` object. Twenty Cloud: https://api.twenty.com
TWENTY_API_URL=
TWENTY_API_KEY=
# Optional: UI host for record links (defaults to TWENTY_API_URL with api. -> app.)
TWENTY_APP_URL=
